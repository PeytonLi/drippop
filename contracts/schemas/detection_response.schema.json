{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drippop.dev/contracts/schemas/detection_response.schema.json",
  "title": "DetectionResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "image_width",
    "image_height",
    "coordinate_space",
    "persons",
    "manual_selection_required"
  ],
  "properties": {
    "image_width": {
      "type": "integer",
      "minimum": 1
    },
    "image_height": {
      "type": "integer",
      "minimum": 1
    },
    "coordinate_space": {
      "const": "normalized_upright_xyxy"
    },
    "persons": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "box",
          "garments"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^p[0-9]{1,2}$"
          },
          "box": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "description": "Normalized [left, top, right, bottom] against the upright source image. Consumers MUST additionally enforce left<right and top<bottom (positive area); JSON Schema cannot express this."
          },
          "garments": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "category",
                "box"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^g[0-9]{1,2}$"
                },
                "category": {
                  "$ref": "garment_category.schema.json"
                },
                "box": {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 4,
                  "items": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "description": "Normalized [left, top, right, bottom] against the upright source image. Consumers MUST additionally enforce left<right and top<bottom (positive area); JSON Schema cannot express this."
                }
              }
            }
          }
        }
      }
    },
    "manual_selection_required": {
      "type": "boolean"
    }
  }
}
